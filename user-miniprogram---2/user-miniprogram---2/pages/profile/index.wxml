<view class="profile-page bg-gradient-primary">
  <custom-nav-bar title="我的" showBack="{{false}}" color="#111827" placeholder="{{false}}" backgroundColor="transparent"></custom-nav-bar>

  <scroll-view class="profile-scroll" scroll-y refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="profile-content">
      <view class="profile-hero active-opacity" bindtap="handleProfileHero">
        <view class="hero-top">
          <view class="avatar-wrap">
            <image class="avatar" wx:if="{{userInfo && userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
            <view class="avatar-placeholder" wx:else>
              <view class="avatar-icon"></view>
            </view>
          </view>

          <view class="user-detail">
            <view class="nickname">{{userInfo ? (userInfo.nickName || '用户') : '点击登录'}}</view>
          </view>

          <view class="hero-arrow"></view>
        </view>

        <view class="hero-alerts">
          <view class="hero-alert-item active-opacity {{profileAlertDetail.messageUnreadCount > 0 ? 'has-alert' : ''}}" catchtap="goToMessages">
            <text class="hero-alert-label">消息</text>
            <text class="hero-alert-value">{{profileAlertDetail.messageUnreadCount > 99 ? '99+' : (profileAlertDetail.messageUnreadCount || 0)}}</text>
          </view>
          <view class="hero-alert-item active-opacity {{profileAlertDetail.couponAlertCount > 0 ? 'has-alert' : ''}}" catchtap="goToCoupons">
            <text class="hero-alert-label">优惠券</text>
            <text class="hero-alert-value">{{profileAlertDetail.couponAlertCount > 99 ? '99+' : (profileAlertDetail.couponAlertCount || 0)}}</text>
          </view>
          <view class="hero-alert-item active-opacity {{profileAlertDetail.aftersaleCount > 0 ? 'has-alert' : ''}}" catchtap="goToOrders" data-type="aftersale">
            <text class="hero-alert-label">售后</text>
            <text class="hero-alert-value">{{profileAlertDetail.aftersaleCount > 99 ? '99+' : (profileAlertDetail.aftersaleCount || 0)}}</text>
          </view>
        </view>
      </view>

      <view class="wallet-card active-opacity" bindtap="goToWallet" wx:if="{{userInfo}}">
        <view class="wallet-main">
          <view class="wallet-copy">
            <text class="wallet-label">钱包余额</text>
            <view class="wallet-balance">¥<number-ticker value="{{balance}}" decimals="2"></number-ticker></view>
          </view>
          <view class="wallet-btn">去钱包</view>
        </view>

        <view class="wallet-stats">
          <view class="wallet-stat active-opacity" catchtap="goToFavorites">
            <text class="wallet-stat-value"><number-ticker value="{{stats.favorite}}"></number-ticker></text>
            <text class="wallet-stat-label">收藏</text>
          </view>
          <view class="wallet-stat active-opacity" catchtap="goToFootprint">
            <text class="wallet-stat-value"><number-ticker value="{{stats.footprint}}"></number-ticker></text>
            <text class="wallet-stat-label">足迹</text>
          </view>
          <view class="wallet-stat active-opacity" catchtap="goToCoupons">
            <text class="wallet-stat-value"><number-ticker value="{{stats.coupon}}"></number-ticker></text>
            <text class="wallet-stat-label">可用券</text>
          </view>
        </view>
      </view>

      <view class="section order-section">
        <view class="section-header active-opacity" bindtap="goToOrders" data-type="all">
          <text class="section-title">我的订单</text>
          <view class="section-more">
            <text>全部订单</text>
            <view class="arrow-right"></view>
          </view>
        </view>

        <view class="order-nav">
          <view class="order-item active-opacity {{orderCount.unpaid > 0 ? 'has-badge' : ''}}" bindtap="goToOrders" data-type="unpaid">
            <view class="order-icon icon-wallet"></view>
            <text class="order-text">待付款</text>
            <view class="badge badge-rose" wx:if="{{orderCount.unpaid > 0}}">{{orderCount.unpaid > 99 ? '99+' : orderCount.unpaid}}</view>
          </view>
          <view class="order-item active-opacity {{orderCount.unshipped > 0 ? 'has-badge' : ''}}" bindtap="goToOrders" data-type="unshipped">
            <view class="order-icon icon-box"></view>
            <text class="order-text">待发货</text>
            <view class="badge badge-rose" wx:if="{{orderCount.unshipped > 0}}">{{orderCount.unshipped > 99 ? '99+' : orderCount.unshipped}}</view>
          </view>
          <view class="order-item active-opacity {{orderCount.unreceived > 0 ? 'has-badge' : ''}}" bindtap="goToOrders" data-type="unreceived">
            <view class="order-icon icon-truck"></view>
            <text class="order-text">待收货</text>
            <view class="badge badge-rose" wx:if="{{orderCount.unreceived > 0}}">{{orderCount.unreceived > 99 ? '99+' : orderCount.unreceived}}</view>
          </view>
          <view class="order-item active-opacity {{orderCount.aftersale > 0 ? 'has-badge' : ''}}" bindtap="goToOrders" data-type="aftersale">
            <view class="order-icon icon-service"></view>
            <text class="order-text">售后</text>
            <view class="badge badge-rose" wx:if="{{orderCount.aftersale > 0}}">{{orderCount.aftersale > 99 ? '99+' : orderCount.aftersale}}</view>
          </view>
        </view>
      </view>

      <view class="section service-section">
        <view class="section-header">
          <text class="section-title">常用服务</text>
        </view>

        <view class="service-list">
          <view class="service-item active-opacity" bindtap="goToMessages">
            <view class="service-left">
              <view class="service-icon icon-message"></view>
              <text class="service-name">消息通知</text>
            </view>
            <view class="service-right-info {{unreadMessageCount > 0 || profileAlertDetail.messageUnreadCount > 0 ? 'has-badge' : ''}}">
              <text class="service-count-badge badge-rose" wx:if="{{unreadMessageCount > 0}}">{{unreadMessageCount > 99 ? '99+' : unreadMessageCount}}</text>
              <view class="service-dot" wx:elif="{{profileAlertDetail.messageUnreadCount > 0}}"></view>
              <view class="arrow-right"></view>
            </view>
          </view>

          <view class="service-item active-opacity" bindtap="goToCustomerService">
            <view class="service-left">
              <view class="service-icon icon-customer-service"></view>
              <text class="service-name">在线客服</text>
            </view>
            <view class="service-right-info {{customerServiceUnreadCount > 0 ? 'has-badge' : ''}}">
              <text class="service-count-badge badge-rose" wx:if="{{customerServiceUnreadCount > 0}}">{{customerServiceUnreadCount > 99 ? '99+' : customerServiceUnreadCount}}</text>
              <view class="arrow-right"></view>
            </view>
          </view>

          <view class="service-item active-opacity" bindtap="goToCoupons">
            <view class="service-left">
              <view class="service-icon icon-coupon"></view>
              <text class="service-name">优惠券</text>
            </view>
            <view class="service-right-info {{profileAlertDetail.couponUnclaimedCount > 0 || profileAlertDetail.couponAlertCount > 0 ? 'has-badge' : ''}}">
              <text class="service-badge" wx:if="{{stats.coupon > 0}}">{{stats.coupon}}张可用</text>
              <text class="service-count-badge badge-rose" wx:if="{{profileAlertDetail.couponAlertCount > 0}}">{{profileAlertDetail.couponAlertCount > 99 ? '99+' : profileAlertDetail.couponAlertCount}}</text>
              <view class="arrow-right"></view>
            </view>
          </view>

          <view class="service-item active-opacity" bindtap="goToAddress">
            <view class="service-left">
              <view class="service-icon icon-location"></view>
              <text class="service-name">地址管理</text>
            </view>
            <view class="service-right-info">
              <view class="arrow-right"></view>
            </view>
          </view>

          <view class="service-item active-opacity" bindtap="goToAbout">
            <view class="service-left">
              <view class="service-icon icon-info"></view>
              <text class="service-name">关于我们</text>
            </view>
            <view class="service-right-info">
              <view class="arrow-right"></view>
            </view>
          </view>

          <view class="service-item active-opacity" bindtap="goToSettings">
            <view class="service-left">
              <view class="service-icon icon-setting"></view>
              <text class="service-name">设置</text>
            </view>
            <view class="service-right-info">
              <view class="arrow-right"></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="page-bottom-spacer page-bottom-spacer--home"></view>
  </scroll-view>
</view>
