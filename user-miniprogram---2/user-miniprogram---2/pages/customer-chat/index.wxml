<view class="chat-page">
  <custom-nav-bar title="{{navTitle}}" showBack="{{true}}" backgroundColor="#ffffff" color="#111111"></custom-nav-bar>

  <scroll-view
    class="chat-scroll"
    scroll-y
    scroll-into-view="{{scrollIntoView}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="loading-wrap" wx:if="{{loading}}">会话加载中...</view>

    <block wx:elif="{{conversation}}">
      <view class="context-card">
        <view class="context-head">
          <text class="context-title">{{conversation.conversationType === 'support' ? '官方客服' : '商家客服'}}</text>
          <text class="context-status">{{conversation.status || 'open'}}</text>
        </view>
        <view class="context-meta">
          <text class="meta-chip {{conversation.isEscalated ? 'is-active' : ''}}">
            {{conversation.isEscalated ? '平台已介入' : '可申请平台介入'}}
          </text>
          <text class="meta-chip" wx:if="{{conversation.conversationType === 'support' && conversation.status === 'ai_serving'}}">智能接待中</text>
          <text class="meta-chip is-queue" wx:if="{{conversation.conversationType === 'support' && conversation.status === 'pending_support'}}">
            {{queueHint || '人工排队中'}}
          </text>
        </view>

        <view class="context-link-row" wx:if="{{conversation.context && conversation.context.order}}">
          <text class="context-link-title">关联订单：{{conversation.context.order.orderNo || ('#' + conversation.context.order.id)}}</text>
          <view class="context-link-btn active-opacity" bindtap="openOrderDetail">查看订单</view>
        </view>
        <view class="context-link-row" wx:if="{{conversation.context && conversation.context.product}}">
          <text class="context-link-title">关联商品：{{conversation.context.product.name || ('#' + conversation.context.product.id)}}</text>
          <view class="context-link-btn active-opacity" bindtap="openProductDetail">查看商品</view>
        </view>
      </view>

      <view class="message-list">
        <view
          class="message-row {{item.isSelf ? 'self' : ''}} {{item.isSystem ? 'system' : ''}}"
          wx:for="{{messages}}"
          wx:key="id"
          id="msg-{{item.id}}"
        >
          <view class="message-bubble">
            <view class="message-meta">{{item.senderName}} · {{item.createTime}}</view>
            <view class="message-content">{{item.content}}</view>
            <view class="agent-data-panel" wx:if="{{item.agentOrders.length}}">
              <view class="agent-data-title">本人最近订单</view>
              <view class="agent-data-row" wx:for="{{item.agentOrders}}" wx:for-item="orderLine" wx:key="*this">{{orderLine}}</view>
              <view class="agent-data-hint">回复订单号即可继续查询或办理售后</view>
            </view>
            <view class="agent-data-panel" wx:if="{{item.refundHistory.length}}">
              <view class="agent-data-title">最近售后记录</view>
              <view class="agent-data-row" wx:for="{{item.refundHistory}}" wx:for-item="refundLine" wx:key="*this">{{refundLine}}</view>
            </view>
            <view class="agent-action" wx:if="{{item.agentAction && (item.agentAction.type === 'refund_apply' || item.agentAction.type === 'order_cancel')}}">
              <view class="agent-action-title">{{item.agentAction.type === 'order_cancel' ? '订单取消' : '售后申请'}} · {{item.agentAction.orderNo}}</view>
              <input
                wx:if="{{item.agentAction.type === 'refund_apply' && item.agentAction.status === 'pending'}}"
                class="agent-action-reason-input"
                value="{{item.agentActionDescription}}"
                maxlength="200"
                placeholder="补充退款原因"
                data-message-id="{{item.id}}"
                bindinput="onAgentActionDescriptionChange"
              />
              <view class="agent-action-reason" wx:elif="{{item.agentAction.description}}">申请原因：{{item.agentAction.description}}</view>
              <button
                class="agent-action-button {{item.canConfirmAgentAction ? '' : 'is-done'}}"
                wx:if="{{item.agentAction.status === 'pending' || item.agentAction.status === 'submitted' || item.agentAction.status === 'expired'}}"
                data-message-id="{{item.id}}"
                bindtap="confirmAgentAction"
                disabled="{{!item.canConfirmAgentAction}}"
              >{{item.agentActionLabel}}</button>
            </view>
          </view>
        </view>

      <view class="empty-message" wx:if="{{messages.length === 0}}">
          暂无消息
      </view>
      </view>

      <view style="height: 220rpx;"></view>
    </block>

    <view class="loading-wrap" wx:else>会话不存在或无权限访问</view>
  </scroll-view>

  <view class="composer-wrap" wx:if="{{conversation}}">
    <scroll-view class="agent-quick-actions" scroll-x wx:if="{{conversation.conversationType === 'support' && conversation.status === 'ai_serving'}}">
      <view class="agent-quick-btn" data-prompt="查看我的订单" bindtap="sendQuickPrompt">查订单</view>
      <view class="agent-quick-btn" data-prompt="查询退款进度" bindtap="sendQuickPrompt">查进度</view>
      <view class="agent-quick-btn" data-prompt="可以申请退款吗" bindtap="sendQuickPrompt">退款条件</view>
      <view class="agent-quick-btn" data-prompt="帮我取消订单" bindtap="sendQuickPrompt">取消订单</view>
    </scroll-view>
    <view class="composer-tools">
      <view
        class="tool-btn active-opacity"
        wx:if="{{conversation.conversationType === 'support' && conversation.status === 'ai_serving'}}"
        bindtap="requestHumanSupport"
      >
        {{requestingHuman ? '提交中...' : '转人工客服'}}
      </view>
      <view
        class="tool-btn disabled"
        wx:if="{{conversation.conversationType === 'support' && conversation.status === 'pending_support'}}"
      >
        {{queueHint || '人工排队中'}}
      </view>
      <view
        class="tool-btn active-opacity"
        wx:if="{{conversation.conversationType === 'merchant' && !conversation.isEscalated}}"
        bindtap="handleEscalate"
      >
        申请平台介入
      </view>
      <view class="tool-btn ghost active-opacity" bindtap="onRefresh">刷新</view>
    </view>

    <view class="composer-row">
      <input
        class="composer-input"
        placeholder="输入消息"
        value="{{inputValue}}"
        bindinput="onInputChange"
        bindconfirm="sendMessage"
        confirm-type="send"
      />
      <view
        class="send-btn active-opacity {{inputValue ? 'active' : ''}}"
        bindtap="sendMessage"
      >
        {{sending ? '发送中' : '发送'}}
      </view>
    </view>
  </view>
</view>
