<view class="conversion-page bg-gradient-primary">
  <custom-nav-bar
    title="{{product ? product.title : ''}}"
    color="{{navColor}}"
    showBack="{{true}}"
    isScrolled="{{isScrolled}}"
    transparentTitle="{{true}}"
    placeholder="{{false}}"
  ></custom-nav-bar>

  <view class="stage-media glass-card" wx:if="{{product}}" style="position: relative; margin: 20rpx; border-radius: 48rpx; overflow: hidden;">
    <view class="glass-overlay-top"></view>
    <swiper class="stage-swiper" bindchange="onGalleryChange" circular autoplay interval="4200" duration="650">
      <swiper-item wx:for="{{product.images}}" wx:key="*this">
        <image class="stage-image" src="{{item}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
    <view class="stage-mask"></view>
    <view class="stage-topline">
      <view class="badge-rose">
        <view class="badge-dot"></view>
        <text>{{seckill ? '限时抢购' : '馆内热卖'}}</text>
      </view>
      <view class="stage-actions">
        <button
          class="stage-share-btn active-opacity"
          open-type="share"
          hover-class="none"
          data-product-id="{{product.id}}"
          data-product-title="{{product.title}}"
          data-product-image="{{product.images[currentImageIndex] || product.images[0]}}"
        >
          <view class="stage-share-icon"></view>
        </button>
        <view class="stage-indicator glass-card-soft" style="padding: 8rpx 16rpx; border-radius: 999rpx;">
          <text class="stage-current">{{currentImageIndex + 1}}</text>
          <text class="stage-total">/{{product.images.length}}</text>
        </view>
      </view>
    </view>
    <view class="stage-seckill glass-card" wx:if="{{seckill}}" style="position: absolute; bottom: 20rpx; left: 20rpx; right: 20rpx; padding: 24rpx; border-radius: 28rpx;">
      <view class="stage-seckill-left">
        <view class="badge-rose" style="margin-bottom: 12rpx;">
          <view class="badge-dot"></view>
          <text>{{seckill.statusLabel}}</text>
        </view>
        <view class="stage-seckill-price">
          <text class="stage-symbol">¥</text>
          <text class="stage-value">{{seckill.seckillPrice}}</text>
          <text class="stage-origin">¥{{seckill.originalPrice}}</text>
        </view>
      </view>
      <view class="stage-seckill-right">
        <text class="stage-countdown">{{seckillCountdownText}}</text>
        <text class="stage-meta">限购 {{seckill.limitPerUser}} · 余量 {{seckill.stock}}</text>
      </view>
    </view>
  </view>

  <view class="main-scroll">
    <view class="main-spacer"></view>

    <view class="main-panel card-elevated-strong" wx:if="{{product}}" style="margin: 20rpx; padding: 32rpx; position: relative;">
      <view class="commerce-content">
        <view class="product-summary-card" id="section-goods">
          <view class="summary-kicker-row">
            <text class="summary-kicker">{{seckill ? '馆内秒杀' : '馆藏推荐'}}</text>
            <text class="summary-kicker-note">{{product.stock > 0 ? '现货可拍' : '暂时缺货'}}</text>
          </view>
          <view class="summary-price-line">
            <view class="summary-price-wrap">
              <text class="summary-price-symbol">¥</text>
              <text class="summary-price-value">{{product.price}}</text>
            </view>
            <view class="summary-meta-row">
              <text class="summary-meta-pill">已售 {{product.salesCount || 0}}</text>
              <text class="summary-meta-pill">评价 {{reviewTotal || 0}}</text>
            </view>
          </view>

          <text class="summary-title">{{product.title}}</text>
          <text class="summary-desc" wx:if="{{product.description}}">{{product.description}}</text>

          <view class="summary-tags" wx:if="{{product.tags.length}}">
            <text class="summary-tag" wx:for="{{product.tags}}" wx:key="*this">{{item}}</text>
          </view>
        </view>

        <view class="service-grid">
          <view class="service-item">
            <text class="service-label">库存</text>
            <text class="service-value">{{product.stock}}</text>
          </view>
          <view class="service-item">
            <text class="service-label">评分</text>
            <text class="service-value">{{product.rating || '暂无'}}</text>
          </view>
          <view class="service-item">
            <text class="service-label">发货</text>
            <text class="service-value">{{product.stock > 0 ? '有货' : '缺货'}}</text>
          </view>
          <view class="service-item">
            <text class="service-label">保障</text>
            <text class="service-value">{{seckill ? '秒杀价' : '官方保障'}}</text>
          </view>
        </view>

      <view class="section-block ai-block" id="section-review">
        <view class="section-header section-head-row section-header-compact">
          <view>
            <view class="section-title">买家怎么说</view>
          </view>
          <view class="review-entry-btn active-opacity" bindtap="goToReviewOrders">
            写评价
          </view>
        </view>

        <view class="review-overview">
          <view class="review-score-card">
            <text class="review-score-value">{{reviewAverage || (product.rating || '5.0')}}</text>
            <text class="review-score-unit">/ 5</text>
          </view>
          <view class="review-overview-meta">
            <text class="review-overview-title">{{reviewFilterRating > 0 ? ((reviewFilteredTotal || 0) + ' 条 ' + reviewFilterRating + ' 星反馈') : ((reviewTotal || 0) + ' 条真实反馈')}}</text>
          </view>
        </view>

        <view class="ai-summary-card" wx:if="{{aiSummaryLoading || aiSummary}}">
          <view class="ai-summary-head">
            <view class="ai-summary-badge">AI帮你先看</view>
            <text class="ai-summary-state" wx:if="{{aiSummaryLoading}}">整理中</text>
          </view>
          <text class="ai-summary-text" wx:if="{{!aiSummaryLoading}}">{{aiSummary === '生成失败' ? '这件商品的评论总结暂时没有生成出来，你可以先看看下面的真实评价。' : aiSummary}}</text>
          <view class="loading-inline review-load-inline" wx:if="{{aiSummaryLoading}}">
            <view class="loading-dot"></view>
            <text>正在整理大家最常提到的反馈</text>
          </view>
          <view class="ai-summary-highlights" wx:if="{{!aiSummaryLoading && aiSummaryHighlights.length}}">
            <text class="ai-summary-highlight" wx:for="{{aiSummaryHighlights}}" wx:key="*this">{{item}}</text>
          </view>
        </view>

        <view class="review-filter-row" wx:if="{{reviewTotal > 0}}">
          <view
            class="review-filter-chip {{reviewFilterRating === item.rating ? 'review-filter-chip-active' : ''}} active-opacity"
            wx:for="{{reviewFilterOptions}}"
            wx:key="rating"
            bindtap="selectReviewFilter"
            data-rating="{{item.rating}}"
          >
            {{item.label}}
          </view>
        </view>

        <view class="loading-inline review-load-inline" wx:if="{{reviewLoading && !reviewList.length}}">
          <view class="loading-dot"></view>
          <text>正在翻看买家反馈</text>
        </view>

        <view class="review-list" wx:if="{{reviewList.length}}">
          <view class="review-card" wx:for="{{reviewList}}" wx:for-index="reviewIndex" wx:key="id">
            <view class="review-card-head">
              <view class="review-user">
                <image wx:if="{{item.avatar}}" class="review-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
                <view wx:else class="review-avatar review-avatar-placeholder">
                  <text>{{item.usernameInitial}}</text>
                </view>
                <view class="review-user-copy">
                  <text class="review-username">{{item.username}}</text>
                  <view class="review-meta-line">
                    <view class="review-stars">
                      <text class="review-star {{star ? 'review-star-active' : ''}}" wx:for="{{item.stars}}" wx:for-item="star" wx:key="index">{{star ? '★' : '☆'}}</text>
                    </view>
                    <text class="review-date">{{item.createTime}}</text>
                  </view>
                </view>
              </view>
              <view class="review-helpful-btn {{item.helpfulVoted ? 'review-helpful-btn-active' : ''}}" bindtap="toggleReviewHelpful" data-id="{{item.id}}" data-index="{{reviewIndex}}">
                有用 {{item.helpfulCount || 0}}
              </view>
            </view>

            <view class="review-tags" wx:if="{{item.tags.length}}">
              <text class="review-tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
            </view>

            <text class="review-content" wx:if="{{item.content}}">{{item.content}}</text>

            <view class="review-image-grid" wx:if="{{item.images.length}}">
              <image
                class="review-image"
                wx:for="{{item.images}}"
                wx:for-item="imageUrl"
                wx:for-index="imageIndex"
                wx:key="*this"
                src="{{imageUrl}}"
                mode="aspectFill"
                bindtap="previewReviewImage"
                data-current="{{imageUrl}}"
                data-review-index="{{reviewIndex}}"
                data-image-index="{{imageIndex}}"
                data-group="images"
              ></image>
            </view>

            <view class="review-append" wx:if="{{item.appendContent || item.appendImages.length}}">
              <text class="review-append-label">追评</text>
              <text class="review-append-content" wx:if="{{item.appendContent}}">{{item.appendContent}}</text>
              <view class="review-image-grid is-append" wx:if="{{item.appendImages.length}}">
                <image
                  class="review-image"
                  wx:for="{{item.appendImages}}"
                  wx:for-item="appendImage"
                  wx:for-index="appendImageIndex"
                  wx:key="*this"
                  src="{{appendImage}}"
                  mode="aspectFill"
                  bindtap="previewReviewImage"
                  data-current="{{appendImage}}"
                  data-review-index="{{reviewIndex}}"
                  data-image-index="{{appendImageIndex}}"
                  data-group="appendImages"
                ></image>
              </view>
            </view>

            <view class="review-reply" wx:if="{{item.reply}}">
              <text class="review-reply-label">商家回复</text>
              <text class="review-reply-content">{{item.reply}}</text>
            </view>
          </view>
        </view>

        <view class="review-empty" wx:elif="{{!reviewLoading}}">
          <text class="review-empty-title">暂时还没有买家反馈</text>
        </view>

        <view class="review-footer-actions">
          <view class="review-load-more active-opacity" wx:if="{{reviewHasMore && !reviewLoadingMore}}" bindtap="loadMoreReviews">再看几条反馈</view>
          <view class="loading-inline review-load-inline" wx:if="{{reviewLoadingMore}}">
            <view class="loading-dot"></view>
            <text>继续整理中</text>
          </view>
        </view>
      </view>

        <view class="section-block" id="section-detail">
          <view class="section-header section-header-compact">
            <view class="section-title">细节展示</view>
          </view>
          <view class="detail-content">
            <image wx:for="{{product.details}}" wx:key="*this" src="{{item}}" mode="widthFix" class="detail-image" lazy-load></image>
          </view>
        </view>

        <view class="section-block" id="section-recommend" wx:if="{{similarProducts.length > 0}}">
          <view class="section-header section-header-compact">
            <view class="section-title">顺手再看看这些</view>
        </view>
        <view class="similar-grid">
          <view class="similar-item-wrap" wx:for="{{similarProducts}}" wx:key="id">
            <product-card
              product="{{item}}"
              className="detail-similar-card"
              showReason="{{false}}"
              bind:cardtap="goToSimilarProduct"
              data-id="{{item.id}}"
              data-rec-token="{{item.recommendationToken}}"
            ></product-card>
          </view>
        </view>
      </view>
      </view>

      <view class="page-bottom-spacer page-bottom-spacer--detail"></view>
    </view>

    <view class="main-panel empty-panel" wx:else>
      <view class="detail-title text-h3">商品不存在或已下架</view>
    </view>
  </view>

  <view class="cta-wrap">
    <view class="cta-bar">
      <view class="cta-icons">
        <view class="cta-icon active-opacity {{isFavorite ? 'is-active' : ''}}" bindtap="toggleFavorite">
          <view class="cta-icon-badge">
            <view class="icon-heart"></view>
          </view>
          <text class="cta-icon-text">收藏</text>
        </view>
        <view class="cta-icon active-opacity" bindtap="openServiceAction">
          <view class="cta-icon-badge">
            <view class="icon-service"></view>
          </view>
          <text class="cta-icon-text">客服</text>
        </view>
        <view class="cta-icon active-opacity" bindtap="goToCart">
          <view class="cta-icon-badge">
            <view class="icon-cart"></view>
          </view>
          <text class="cta-icon-text">购物车</text>
        </view>
      </view>
      <view class="cta-buttons cta-buttons--single" wx:if="{{product && seckill && seckill.status === 3}}">
        <view class="btn-disabled glass-card-soft">已售罄</view>
      </view>
      <view class="cta-buttons cta-buttons--single" wx:elif="{{product && product.stock > 0 && seckill && seckill.status === 1 && seckill.stock > 0}}">
        <view class="btn-buy btn-primary-gradient hover-scale" bindtap="openSkuPopup" data-mode="seckill">立即秒杀</view>
      </view>
      <view class="cta-buttons cta-buttons--single" wx:elif="{{product && product.stock > 0 && seckill && seckill.status === 0}}">
        <view class="btn-buy glass-card-soft hover-scale btn-buy-soft" bindtap="openSkuPopup" data-mode="seckill">即将开始</view>
      </view>
      <view class="cta-buttons cta-buttons--dual" wx:elif="{{product && product.stock > 0}}">
        <view class="btn-cart glass-card-soft hover-scale" bindtap="openSkuPopup" data-mode="cart">加入购物车</view>
        <view class="btn-buy btn-primary-gradient hover-scale" bindtap="openSkuPopup" data-mode="buy">立即购买</view>
      </view>
      <view class="cta-buttons cta-buttons--single" wx:elif="{{product && seckill && seckill.status === 0}}">
        <view class="btn-disabled glass-card-soft">即将开始</view>
      </view>
      <view class="cta-buttons cta-buttons--single" wx:elif="{{product}}">
        <view class="btn-disabled glass-card-soft">暂时缺货</view>
      </view>
    </view>
  </view>

  <custom-popup show="{{showSkuPopup}}" position="bottom" round closeable bind:close="closeSkuPopup">
    <view class="sku-popup">
      <view class="sku-header">
        <image class="sku-img" src="{{product.images[0] || product.image}}" mode="aspectFill"></image>
        <view class="sku-info">
          <view class="sku-topline">
            <view class="sku-badge">{{buyMode === 'seckill' ? '秒杀下单' : '下单确认'}}</view>
          </view>
          <view class="sku-price-line">
            <text class="sku-price-symbol">¥</text>
            <text class="sku-price-value">{{buyMode === 'seckill' && seckill ? seckill.seckillPrice : product.price}}</text>
          </view>
        <view class="sku-meta-list">
          <view class="sku-meta-item">库存 {{buyMode === 'seckill' && seckill ? seckill.stock : product.stock}} 件</view>
        </view>
      </view>
      </view>

      <scroll-view scroll-y class="sku-body">
        <view class="sku-section sku-group">
          <view class="sku-section-head">
            <view class="sku-title">规格</view>
          </view>
          <view class="sku-list">
            <view class="sku-item active">规格</view>
          </view>
        </view>

        <view class="sku-section sku-quantity-wrap">
          <view class="sku-quantity-copy">
            <view class="sku-title">购买数量</view>
          </view>
          <view class="stepper">
            <view class="stepper-btn {{!canDecreaseSku ? 'disabled' : ''}}" bindtap="decreaseQuantity">-</view>
            <input class="stepper-input" type="number" value="{{skuQuantity}}" bindinput="onQuantityChange" />
            <view class="stepper-btn {{!canIncreaseSku ? 'disabled' : ''}}" bindtap="increaseQuantity">+</view>
          </view>
        </view>
      </scroll-view>

      <view class="sku-footer">
        <view class="sku-confirm-btn hover-scale" bindtap="confirmSku">{{buyMode === 'seckill' ? '立即秒杀' : '确定'}}</view>
      </view>
    </view>
  </custom-popup>
</view>

<cart-parabola id="cartParabola"></cart-parabola>

