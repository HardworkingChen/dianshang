<view class="home-page bg-gradient-primary">
  <custom-nav-bar title="豫见好物" color="{{navColor}}" transparentTitle="{{!isScrolled}}" isScrolled="{{isScrolled}}" showBack="{{false}}" placeholder="{{false}}">
    <view slot="right" class="home-message-btn glass-card-soft active-opacity" bindtap="goToMessages">
      <view class="home-message-icon"></view>
      <view class="home-message-badge badge-rose" wx:if="{{unreadMessageCount > 0}}" style="position: absolute; top: -8rpx; right: -8rpx; min-width: 32rpx; height: 32rpx; padding: 0 8rpx; font-size: 18rpx;">{{unreadMessageCount > 99 ? '99+' : unreadMessageCount}}</view>
    </view>
  </custom-nav-bar>

  <view class="home-top-shell">
    <view class="home-search-shell active-opacity" bindtap="goToSearchEntry">
      <view class="home-search-entry">
        <view class="home-search-icon"></view>
        <text class="home-search-placeholder">搜河南好物</text>
      </view>
    </view>

  <view class="hero-stage glass-card" style="position: relative;">
    <view class="glass-overlay-top"></view>
    <swiper class="hero-swiper" autoplay circular interval="5000" duration="900" bindchange="onSwiperChange">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="hero-slide" bindtap="goToBanner" data-index="{{index}}">
          <image class="hero-image {{currentBanner === index ? 'ken-burns' : ''}}" src="{{item.image}}" mode="aspectFill"></image>
          <view class="hero-shade"></view>
          <view class="hero-copy">
            <view class="badge-rose" style="margin-bottom: 16rpx;">
              <view class="badge-dot"></view>
              <text>河南馆精选</text>
            </view>
            <text class="hero-title text-ellipsis">{{item.title || '今天值得带走的河南好物'}}</text>
            <text class="hero-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
            <view class="hero-action btn-primary-gradient">去挑礼物</view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="hero-dots" wx:if="{{banners.length > 1}}">
      <view class="hero-dot {{currentBanner === index ? 'hero-dot-active' : ''}}" wx:for="{{banners}}" wx:key="id"></view>
    </view>
  </view>

    <view class="home-quick-strip">
      <view class="quick-entry surface-panel active-opacity" bindtap="goToSeckillHall">
        <text class="quick-entry-label">限时秒杀</text>
        <text class="quick-entry-desc">看看今天哪几款河南好物正在抢购</text>
      </view>
      <view class="quick-entry surface-panel active-opacity" bindtap="goToExplore">
        <text class="quick-entry-label">逛河南馆</text>
        <text class="quick-entry-desc">按茶礼、熟食、文创和花礼慢慢挑</text>
      </view>
      <view class="quick-entry surface-panel active-opacity" bindtap="goToCouponsQuick">
        <text class="quick-entry-label">领券中心</text>
        <text class="quick-entry-desc">先领券再下单，伴手礼凑单更划算</text>
      </view>
    </view>
  </view>

  <view class="home-body">
    <view class="zone zone-inspiration">
      <view class="zone-head">
        <view class="zone-head-title-wrap">
          <view class="zone-title-stack">
            <text class="zone-kicker">地方馆</text>
            <text class="zone-title">逛逛本地好物</text>
          </view>
        </view>
        <view class="zone-more active-opacity" bindtap="goToExplore">去河南馆<view class="arrow-right-small"></view></view>
      </view>
      <scroll-view class="inspiration-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="inspiration-list">
          <view class="inspiration-item {{item.toneClass || ''}} active-opacity" wx:for="{{inspirations}}" wx:key="id" bindtap="goToInspiration" data-index="{{index}}">
            <view class="inspiration-icon">
              <image wx:if="{{item.iconImage}}" class="inspiration-icon-image" src="{{item.iconImage}}" mode="aspectFit"></image>
              <view wx:else class="inspiration-glyph {{item.iconClass || 'icon-default'}}"></view>
            </view>
            <text class="inspiration-text">{{item.title}}</text>
            <text class="inspiration-sub">本地甄选</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="feature-duo" wx:if="{{belowFoldReady}}">
      <view class="feature-panel feature-panel-seckill">
        <view class="feature-panel-head">
          <view class="zone-head-title-wrap">
            <text class="zone-title">限时秒杀</text>
            <text class="zone-tag-hot">{{seckillHistoryMode ? '往期' : '热卖'}}</text>
          </view>
          <view class="zone-side">
            <text class="zone-count" wx:if="{{seckillProducts.length}}">{{seckillProducts.length}} 件</text>
            <view class="zone-more active-opacity" bindtap="goToSeckillHall">会场<view class="arrow-right-small"></view></view>
          </view>
        </view>

        <view class="feature-empty" wx:if="{{!seckillLoading && !seckillProducts.length}}">
          <text class="section-empty-text">暂无秒杀</text>
        </view>

        <view
          class="feature-cover feature-cover-seckill active-opacity"
          wx:elif="{{seckillProducts.length}}"
          bindtap="goToSeckillProduct"
          data-id="{{seckillProducts[0].id}}"
        >
          <image wx:if="{{seckillProducts[0].image}}" class="feature-cover-image" src="{{seckillProducts[0].image}}" mode="aspectFill"></image>
          <view wx:else class="feature-cover-image image-placeholder">
            <text class="image-placeholder-text">暂无图片</text>
          </view>
          <view class="feature-cover-shade"></view>
          <view class="feature-cover-content">
            <view class="feature-cover-topline">
              <text class="seckill-status-badge {{seckillProducts[0].seckillStatus === 1 ? 'active' : (seckillProducts[0].seckillStatus === 0 ? 'pending' : 'ended')}}">{{seckillProducts[0].seckillStatusLabel}}</text>
              <text class="feature-cover-kicker">秒杀</text>
            </view>
            <text class="feature-cover-title text-ellipsis-2">{{seckillProducts[0].title}}</text>
            <text class="feature-cover-sub">{{seckillProducts[0].countdownText}}</text>
            <view class="feature-cover-price-row">
              <text class="feature-cover-price"><text class="seckill-price-symbol">¥</text>{{seckillProducts[0].seckillPrice}}</text>
              <text class="feature-cover-meta">{{seckillProducts[0].soldText}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="feature-panel feature-panel-hot">
        <view class="feature-panel-head">
          <view class="zone-head-title-wrap">
            <text class="zone-title">实时热榜</text>
            <text class="zone-chip">实时</text>
          </view>
          <view class="zone-side">
            <text class="zone-count" wx:if="{{realtimeHotProducts.length}}">{{realtimeHotWindowLabel}}</text>
          </view>
        </view>

        <view class="stream-hot-tabs feature-hot-tabs">
          <view
            class="stream-hot-tab {{realtimeHotWindow === item.value ? 'is-active' : ''}}"
            wx:for="{{[{label:'1分钟',value:'1m'},{label:'1小时',value:'1h'},{label:'1天',value:'1d'}]}}"
            wx:key="value"
            data-window="{{item.value}}"
            bindtap="switchRealtimeHotWindow"
          >
            {{item.label}}
          </view>
        </view>

        <view class="feature-empty" wx:if="{{!realtimeHotLoading && !realtimeHotProducts.length}}">
          <text class="section-empty-text">暂无热榜</text>
        </view>

        <view
          class="feature-cover feature-cover-hot active-opacity"
          wx:elif="{{realtimeHotProducts.length}}"
          bindtap="goToRealtimeHotProduct"
          data-id="{{realtimeHotProducts[0].id}}"
        >
          <image class="feature-cover-image" src="{{realtimeHotProducts[0].image}}" mode="aspectFill"></image>
          <view class="feature-cover-shade"></view>
          <view class="feature-cover-content">
            <view class="feature-cover-topline">
              <text class="feature-rank-pill">热榜 #{{realtimeHotProducts[0].rank}}</text>
              <text class="feature-cover-kicker">{{realtimeHotProducts[0].categoryLabel}}</text>
            </view>
            <text class="feature-cover-title text-ellipsis-2">{{realtimeHotProducts[0].title}}</text>
            <text class="feature-cover-sub">{{realtimeHotWindowLabel}}热度趋势</text>
            <view class="feature-cover-price-row">
              <text class="feature-cover-price">{{realtimeHotProducts[0].priceText}}</text>
              <text class="feature-cover-meta">销量 {{realtimeHotProducts[0].salesText}}</text>
            </view>
          </view>
        </view>

        <view class="stream-hot-update feature-hot-update" wx:if="{{realtimeHotLastUpdate}}">
          {{realtimeHotLastUpdate}}
        </view>
      </view>
    </view>

    <view class="feed-zone card-elevated-strong" style="position: relative;">
      <view class="zone-head">
        <view class="zone-head-title-wrap">
          <view class="zone-title-stack">
            <text class="zone-kicker">掌柜推荐</text>
            <text class="text-heading">{{recommendTitle}}</text>
          </view>
        </view>
        <view class="zone-side">
          <view class="zone-refresh-btn glass-card-soft active-opacity" bindtap="onRecommendRefreshTap">换一批</view>
          <text class="zone-count" wx:if="{{products.length}}" style="color: var(--text-tertiary); font-size: 22rpx;">{{products.length}} 件</text>
        </view>
      </view>

      <view class="feed-grid">
        <block wx:if="{{loading && products.length === 0}}">
          <view class="feed-item-wrap" wx:for="{{4}}" wx:key="*this">
            <product-card skeleton="{{true}}" showReason="{{false}}" showAddCart="{{true}}"></product-card>
          </view>
        </block>
        <block wx:else>
          <view class="feed-item-wrap" wx:for="{{products}}" wx:key="id">
            <view class="feed-card-shell">
              <product-card
                product="{{item}}"
                className="glass-card-soft {{item.visualClass || ''}}"
                showReason="{{false}}"
                showAddCart="{{false}}"
                showSales="{{true}}"
                showDislike="{{false}}"
                bind:cardtap="goToDetail"
                data-id="{{item.id}}"
                data-rec-token="{{item.recommendationToken}}"
              ></product-card>
              <view
                class="feed-add-btn {{item.isSeckillDirectBuy ? 'feed-add-btn--seckill' : ''}} active-opacity"
                catchtap="onFeedAddTap"
                data-section="products"
                data-index="{{index}}"
                data-id="{{item.id}}"
                data-rec-token="{{item.recommendationToken}}"
              >
                <view class="{{item.isSeckillDirectBuy ? 'feed-add-icon feed-add-icon--seckill' : 'feed-add-icon'}}"></view>
              </view>
            </view>
            <view class="feed-reason-line" wx:if="{{item.recommendReasonText}}">
              <text class="feed-reason-kicker">推荐理由</text>
              <text class="feed-reason-text">{{item.recommendReasonText}}</text>
            </view>
          </view>
        </block>
      </view>

      <view class="load-more-wrap" wx:if="{{!loading && products.length}}">
        <view class="loading-more" wx:if="{{loadingMore}}">
          <view class="loading-dot-anim"></view>
          <text class="loading-more-text">正在上新</text>
        </view>
        <view class="no-more" wx:elif="{{!hasMore}}">
          <text class="no-more-text">先逛到这里</text>
        </view>
      </view>
    </view>

    <view class="feed-zone latest-zone" wx:if="{{belowFoldReady}}">
      <view class="zone-head">
        <view class="zone-head-title-wrap">
          <view class="zone-title-stack">
            <text class="zone-kicker">新到馆</text>
            <text class="zone-title">最近上新的好物</text>
          </view>
          <text class="zone-chip">上新</text>
        </view>
        <text class="zone-count" wx:if="{{latestProducts.length}}">{{latestProducts.length}} 件</text>
      </view>

      <view class="section-empty" wx:if="{{!latestLoading && !latestProducts.length}}">
        <text class="section-empty-text">新到馆好物正在路上</text>
      </view>

      <view class="feed-grid" wx:else>
        <view class="feed-item-wrap" wx:for="{{latestProducts}}" wx:key="id">
          <view class="feed-card-shell">
            <product-card
              product="{{item}}"
              className="{{item.visualClass || ''}}"
              showReason="{{false}}"
              showAddCart="{{false}}"
              showSales="{{true}}"
              bind:cardtap="goToDetail"
              data-id="{{item.id}}"
              data-rec-token="{{item.recommendationToken}}"
            ></product-card>
            <view
              class="feed-add-btn {{item.isSeckillDirectBuy ? 'feed-add-btn--seckill' : ''}} active-opacity"
              catchtap="onFeedAddTap"
              data-section="latestProducts"
              data-index="{{index}}"
              data-id="{{item.id}}"
              data-rec-token="{{item.recommendationToken}}"
            >
              <view class="{{item.isSeckillDirectBuy ? 'feed-add-icon feed-add-icon--seckill' : 'feed-add-icon'}}"></view>
            </view>
          </view>
          <view class="feed-reason-line" wx:if="{{item.recommendReasonText}}">
            <text class="feed-reason-kicker">推荐理由</text>
            <text class="feed-reason-text">{{item.recommendReasonText}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="page-bottom-spacer page-bottom-spacer--home"></view>
</view>

<custom-popup show="{{showCouponPopup}}" position="center" round closeable customStyle="width: 456rpx; max-width: calc(100vw - 96rpx);" bind:close="closeCouponPopup">
  <view class="coupon-popup">
    <view class="coupon-popup-head">
      <text class="coupon-popup-badge">优惠券</text>
      <view class="coupon-popup-icon"></view>
    </view>
    <view class="popup-title">优惠券</view>
    <view class="coupon-popup-panel">
      <view class="coupon-popup-stat">
        <text class="coupon-popup-stat-value">{{unclaimedCount}}</text>
        <text class="coupon-popup-stat-label">待领取</text>
      </view>
    </view>
    <view class="popup-btn" bindtap="goToCouponsFromPopup">去领券</view>
  </view>
</custom-popup>

<custom-popup show="{{showInterestPopup}}" position="center" round closeable bind:close="closeInterestPopup">
  <view class="interest-popup">
    <view class="interest-title">选择你感兴趣的分类</view>
    <view class="interest-grid">
      <view
        wx:for="{{interestCategories}}"
        wx:key="id"
        class="interest-item {{item.selected ? 'interest-selected' : ''}}"
        bindtap="toggleInterest"
        data-index="{{index}}"
      >
        <image class="interest-icon" src="{{item.icon}}" mode="aspectFill"></image>
        <text class="interest-name">{{item.name}}</text>
      </view>
    </view>
    <view class="interest-actions">
      <view class="interest-skip" bindtap="closeInterestPopup">跳过</view>
      <view class="interest-confirm {{selectedInterestCount > 0 && !interestSubmitting ? '' : 'disabled'}}" bindtap="confirmInterest">
        {{interestSubmitting ? '保存中...' : '确认选择' + (selectedInterestCount > 0 ? '(' + selectedInterestCount + ')' : '')}}
      </view>
    </view>
  </view>
</custom-popup>

<cart-parabola id="cartParabola"></cart-parabola>
