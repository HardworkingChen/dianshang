<scroll-view class="explore-page" scroll-y bindscroll="onScroll" bindscrolltolower="onReachBottom" lower-threshold="200" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
  <view class="explore-atmosphere explore-atmosphere-a"></view>
  <view class="explore-atmosphere explore-atmosphere-b"></view>
  <view class="explore-grid-mask"></view>

  <custom-nav-bar title="河南馆" showBack="{{false}}" isScrolled="{{isScrolled}}" backgroundColor="#ffffff" color="#111111"></custom-nav-bar>

  <view class="search-shell {{isScrolled ? 'search-shell-scrolled' : ''}}">
    <view class="search-bar">
      <view class="search-icon"></view>
      <input
        class="search-input"
        placeholder="搜信阳毛尖、胡辣汤、伴手礼"
        placeholder-class="search-placeholder"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearchConfirm"
      />
      <view class="search-trigger active-opacity" bindtap="onSearchConfirm">去找</view>
    </view>
  </view>

  <view class="hot-shell" wx:if="{{hotTags.length > 0}}">
    <view class="shell-head">
      <view class="shell-head-main">
        <text class="shell-title">大家都在找</text>
      </view>
      <view class="shell-sub">馆内热搜</view>
    </view>
    <scroll-view scroll-x enable-flex class="hot-scroll" show-scrollbar="{{false}}">
      <view class="hot-wrap">
        <view class="hot-chip active-opacity" wx:for="{{hotTags}}" wx:key="*this" bindtap="onTagClick" data-tag="{{item}}">
          <text class="hot-chip-mark">#</text>
          <text class="hot-chip-text">{{item}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="category-shell" wx:if="{{categories.length > 0}}">
    <view class="shell-head">
      <view class="shell-head-main">
        <text class="shell-title">按风味慢慢逛</text>
      </view>
      <view class="shell-sub">{{activeCategoryName || '整座河南馆'}}</view>
    </view>
    <scroll-view scroll-x enable-flex class="category-scroll" show-scrollbar="{{false}}">
      <view class="category-list">
        <view class="category-item {{activeCategory === '' ? 'active' : ''}}" bindtap="switchCategory" data-id="" data-name="">
          <view class="category-icon-wrap all-icon">
            <image class="category-image" src="/assets/generated/category-all.png" mode="aspectFit"></image>
          </view>
          <text class="category-name">全馆</text>
        </view>
        <view
          class="category-item {{activeCategory == item.id ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          bindtap="switchCategory"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
        >
          <view class="category-icon-wrap">
            <image wx:if="{{item.iconImage}}" class="category-image" src="{{item.iconImage}}" mode="aspectFit"></image>
            <view wx:else class="category-glyph {{item.iconClass || 'icon-default'}}"></view>
          </view>
          <text class="category-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="products-shell">
    <view class="shell-head products-head" wx:if="{{products.length > 0}}">
      <view class="shell-head-main">
        <text class="shell-title">{{activeCategoryName || '馆内好物'}}</text>
      </view>
      <view class="shell-sub">{{products.length}} 份在逛</view>
    </view>

    <view class="feed-skeleton" wx:if="{{loadingProducts && products.length === 0}}">
      <view class="skeleton-feature"></view>
      <view class="skeleton-row" wx:for="{{skeletonRows}}" wx:key="*this"></view>
    </view>

    <block wx:else>
      <view class="product-grid" wx:if="{{products.length > 0}}">
        <view
          class="product-grid-item"
          wx:for="{{products}}"
          wx:key="id"
        >
          <product-card
            product="{{item}}"
            showSales="{{true}}"
            showReason="{{false}}"
            showAddCart="{{false}}"
            showDislike="{{false}}"
            bind:cardtap="goToDetail"
            data-id="{{item.id}}"
          ></product-card>
        </view>
      </view>
    </block>

    <view class="loading-more" wx:if="{{loadingProducts}}">
      <view class="loading-dot"></view>
      <text>正在摆上新货…</text>
    </view>
    <view class="no-more" wx:elif="{{!hasMoreProducts && products.length}}">
      <text>这一排已经逛完了</text>
    </view>

    <view class="empty-state" wx:if="{{!loadingProducts && !products.length}}">
      <view class="empty-icon"></view>
      <view class="empty-title">这会儿还没找到合适的</view>
      <view class="empty-desc">换个河南特产关键词，或者去别的馆里逛逛</view>
    </view>
  </view>

  <view style="height: 188rpx;"></view>
</scroll-view>
