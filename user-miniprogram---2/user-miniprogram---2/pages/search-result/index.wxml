<scroll-view class="container" scroll-y bindscrolltolower="onReachBottom" lower-threshold="120" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
<custom-nav-bar title="{{pageTitle}}" showBack="{{true}}" backgroundColor="#ffffff" color="#111111"></custom-nav-bar>

  <view class="hero-panel">
    <view class="hero-title" wx:if="{{keyword}}">“{{keyword}}” 的结果</view>
    <view class="hero-title" wx:elif="{{categoryName}}">分类 · {{categoryName}}</view>
    <view class="hero-title" wx:else>馆内找好物</view>
    <view class="hero-desc" wx:if="{{!loading && products.length}}">共找到 {{totalCount || products.length}} 份好物</view>
  </view>

  <scroll-view class="sort-scroll" scroll-x enable-flex show-scrollbar="{{false}}" wx:if="{{products.length}}">
    <view class="sort-bar">
      <view
        class="sort-item {{sortBy === item.value ? 'sort-item-active' : ''}}"
        wx:for="{{sortOptions}}"
        wx:key="value"
        bindtap="onSortChange"
        data-value="{{item.value}}"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">正在馆里帮你找</view>
  </view>

  <view class="result-list" wx:elif="{{products.length}}">
    <view class="result-header">
      <text class="result-title">找到这些值得带走</text>
    </view>
    <view class="result-grid">
      <view class="result-item-wrap" wx:for="{{products}}" wx:key="id">
        <product-card
          product="{{item}}"
          className="search-result-product"
          showSales="{{true}}"
          bind:cardtap="goToDetail"
          data-id="{{item.id}}"
          data-rec-token="{{item.recommendationToken}}"
        ></product-card>
      </view>
    </view>
  </view>

  <block wx:elif="{{!loading}}">
    <view class="empty-wrap">
      <view class="empty-icon-wrap">
        <view class="empty-search-icon"></view>
      </view>
      <view class="empty-title">暂时没翻到合适的</view>
      <view class="empty-desc" wx:if="{{keyword}}">{{keyword}}</view>
      <view class="empty-desc" wx:elif="{{categoryName}}">{{categoryName}}</view>
      <view class="empty-desc" wx:elif="{{categoryId}}">换个分类再试试</view>
      <view class="empty-desc" wx:else>不如先看看馆里正在热卖的</view>
    </view>

    <view class="recommend-section" wx:if="{{recommendProducts.length}}">
      <view class="recommend-header">
        <view class="recommend-line"></view>
        <text class="recommend-title">先看看这些馆藏热门</text>
        <view class="recommend-line"></view>
      </view>
      <view class="recommend-grid">
        <view class="recommend-item-wrap" wx:for="{{recommendProducts}}" wx:key="id">
          <product-card
            product="{{item}}"
            className="search-result-recommend"
            showReason="{{false}}"
            showSales="{{true}}"
            bind:cardtap="goToDetail"
            data-id="{{item.id}}"
            data-rec-token="{{item.recommendationToken}}"
          ></product-card>
        </view>
      </view>
    </view>
  </block>

  <view class="load-more" wx:if="{{!loading && products.length && hasMore}}">
    <view class="loading-text">继续往下翻</view>
  </view>
  <view class="load-more" wx:if="{{!loading && products.length && !hasMore}}">
    <view class="no-more-text">这次先帮你翻到这里</view>
  </view>

  <view style="height: 40rpx;"></view>
</scroll-view>

